<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1788670696087-1"
               author="SURAJ">
        <createTable schemaName="core"
                     tableName="deposit_account">
            <column autoIncrement="true"
                    name="id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_deposit_account"/>
            </column>
            <column name="account_number"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="account_type"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code"
                    type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="opened_at"
                    type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at"
                    type="DATETIME(6)"/>
            <column name="created_at"
                    type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at"
                    type="DATETIME(6)"/>
            <column name="balance"
                    type="DECIMAL(20, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_rate"
                    type="DECIMAL(7, 4)"/>
            <column name="minimum_balance"
                    type="DECIMAL(20, 2)"/>
        </createTable>
    </changeSet>
    <changeSet id="1788670696087-2"
               author="SURAJ">
        <addUniqueConstraint columnNames="account_number"
                             constraintName="uc_deposit_account_account_number"
                             schemaName="core"
                             tableName="deposit_account"/>
    </changeSet>

</databaseChangeLog>
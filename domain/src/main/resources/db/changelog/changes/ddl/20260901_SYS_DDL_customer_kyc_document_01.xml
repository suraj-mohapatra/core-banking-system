<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1788664546817-1"
               author="SURAJ">
        <createTable schemaName="core"
                     tableName="customer_kyc_document">
            <column autoIncrement="true"
                    name="id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_customer_kyc_document"/>
            </column>
            <column name="customer_kyc_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="document_master_id"
                    type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="document_code"
                    type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="document_type"
                    type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="document_name"
                    type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name"
                    type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="file_path"
                    type="VARCHAR(500)"/>
            <column name="file_url"
                    type="VARCHAR(500)"/>
            <column name="mime_type"
                    type="VARCHAR(100)"/>
            <column name="file_size"
                    type="BIGINT"/>
            <column name="uploaded_at"
                    type="DATETIME(6)"/>
            <column name="uploaded_by"
                    type="VARCHAR(100)"/>
            <column name="verification_status"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="verified_by"
                    type="VARCHAR(100)"/>
            <column name="verified_at"
                    type="DATETIME(6)"/>
            <column name="reject_reason"
                    type="VARCHAR(1000)"/>
            <column name="expiry_date"
                    type="DATE"/>
            <column name="is_mandatory"
                    type="BOOLEAN"/>
            <column name="is_active"
                    type="BOOLEAN"/>
            <column name="created_at"
                    type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at"
                    type="DATETIME(6)"/>
        </createTable>
    </changeSet>
    <changeSet id="1788664546817-2"
               author="SURAJ">
        <addForeignKeyConstraint baseColumnNames="customer_kyc_id"
                                 baseTableName="customer_kyc_document"
                                 baseTableSchemaName="core"
                                 constraintName="FK_CUSTOMER_KYC_DOCUMENT_ON_CUSTOMER_KYC"
                                 referencedColumnNames="id"
                                 referencedTableName="customer_kyc"
                                 referencedTableSchemaName="core"/>
    </changeSet>
    <changeSet id="1788664546817-3"
               author="SURAJ">
        <addForeignKeyConstraint baseColumnNames="document_master_id"
                                 baseTableName="customer_kyc_document"
                                 baseTableSchemaName="core"
                                 constraintName="FK_CUSTOMER_KYC_DOCUMENT_ON_DOCUMENT_MASTER"
                                 referencedColumnNames="id"
                                 referencedTableName="kyc_document_master"
                                 referencedTableSchemaName="core"/>
    </changeSet>

</databaseChangeLog>
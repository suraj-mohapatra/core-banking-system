<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1788664509223-1"
               author="SURAJ">
        <createTable schemaName="core"
                     tableName="customer_kyc">
            <column autoIncrement="true"
                    name="id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_customer_kyc"/>
            </column>
            <column name="customer_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="kyc_type"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="kyc_status"
                    type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="submitted_at"
                    type="DATETIME(6)"/>
            <column name="submitted_by"
                    type="VARCHAR(100)"/>
            <column name="source_channel"
                    type="VARCHAR(50)"/>
            <column name="document_count"
                    type="INT"/>
            <column name="verified_at"
                    type="DATETIME(6)"/>
            <column name="verified_by"
                    type="VARCHAR(100)"/>
            <column name="verification_mode"
                    type="VARCHAR(50)"/>
            <column name="review_comments"
                    type="VARCHAR(1000)"/>
            <column name="rejection_reason"
                    type="VARCHAR(1000)"/>
            <column name="pan_verified"
                    type="BOOLEAN"/>
            <column name="aadhaar_verified"
                    type="BOOLEAN"/>
            <column name="address_verified"
                    type="BOOLEAN"/>
            <column name="pep_check_status"
                    type="VARCHAR(30)"/>
            <column name="sanction_check_status"
                    type="VARCHAR(30)"/>
            <column name="risk_rating"
                    type="VARCHAR(20)"/>
            <column name="expiry_date"
                    type="DATE"/>
            <column name="re_kyc_required"
                    type="BOOLEAN"/>
            <column name="re_kyc_due_date"
                    type="DATE"/>
            <column name="is_active"
                    type="BOOLEAN"/>
            <column name="created_at"
                    type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at"
                    type="DATETIME(6)"/>
        </createTable>
    </changeSet>
    <changeSet id="1788664509223-2"
               author="SURAJ">
        <addUniqueConstraint columnNames="customer_id"
                             constraintName="uc_customer_kyc_customer"
                             schemaName="core"
                             tableName="customer_kyc"/>
    </changeSet>

</databaseChangeLog>